---
/**
 * The constraint keyed on spelling, as a figure.
 *
 * Form: this is not a magnitude, it is a set membership question, so it is set
 * out as a list with a boundary rather than as a chart. The three ids are shown
 * as text at reading size because the whole bug lives in their last two
 * characters, and abstracting that away would abstract away the point.
 *
 * The thumb variant cannot use text: SVG type scales with the viewBox and this
 * would land at about five pixels on a phone. It keeps the shape of the idea
 * instead, two rows inside the boundary and one outside, with the version
 * suffix detached on the row that fell out.
 */
interface Props {
  variant?: "hero" | "thumb";
}

const { variant = "hero" } = Astro.props;
const thumb = variant === "thumb";
---

<svg
  viewBox={thumb ? "0 0 400 216" : "0 0 1200 460"}
  role="img"
  aria-label="The pattern caret claude dash dot star dash five dollar matched claude-sonnet-5 and claude-fable-5 but not claude-opus-4-8, which was sent a temperature its provider rejects and returned HTTP 400."
  xmlns="http://www.w3.org/2000/svg"
  class={thumb ? "dg dg-t" : "dg"}
>
  {
    thumb ? (
      <>
        {/* inside the boundary */}
        <line class="dg-brace" x1="28" y1="36" x2="28" y2="118" />
        <rect class="dg-body" x="48" y="44" width="210" height="26" rx="3" />
        <rect class="dg-tail" x="266" y="44" width="44" height="26" rx="3" />
        <rect class="dg-body" x="48" y="84" width="190" height="26" rx="3" />
        <rect class="dg-tail" x="246" y="84" width="44" height="26" rx="3" />

        {/* outside it, with the suffix detached */}
        <line class="dg-brace-on" x1="28" y1="140" x2="28" y2="182" />
        <rect class="dg-body dg-on" x="48" y="148" width="210" height="26" rx="3" />
        <rect class="dg-open" x="276" y="148" width="44" height="26" rx="3" />
      </>
    ) : (
      <>
        <text class="dg-cap" x="60" y="58">
          WHAT THE GUARD ACTUALLY MATCHED
        </text>
        <text class="dg-cap dg-end" x="1140" y="58">
          /^CLAUDE-.*-5$/
        </text>
        <line class="dg-rule" x1="60" y1="80" x2="1140" y2="80" />

        <line class="dg-brace" x1="296" y1="104" x2="296" y2="240" />
        <text class="dg-cap" x="316" y="124">
          MATCHED
        </text>
        <text class="dg-id" x="316" y="176">
          claude-sonnet-5
        </text>
        <text class="dg-id" x="316" y="226">
          claude-fable-5
        </text>
        <text class="dg-val dg-end" x="1140" y="176">
          temperature 1, answers
        </text>
        <text class="dg-val dg-end" x="1140" y="226">
          temperature 1, answers
        </text>

        <line class="dg-brace-on" x1="296" y1="276" x2="296" y2="362" />
        <text class="dg-cap dg-on" x="316" y="296">
          MISSED
        </text>
        <text class="dg-id dg-on" x="316" y="348">
          claude-opus-4-8
        </text>
        <text class="dg-val dg-on dg-end" x="1140" y="348">
          temperature 0, HTTP 400
        </text>

        <line class="dg-rule" x1="60" y1="412" x2="1140" y2="412" />
        <text class="dg-cap" x="60" y="440">
          THE ID DOES NOT END IN 5, SO THE MOST EXPENSIVE MODEL NEVER ANSWERED
        </text>
      </>
    )
  }
</svg>

<style>
  .dg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--fg);
  }

  .dg text {
    font-family: var(--mono);
    fill: currentColor;
  }

  .dg-cap {
    font-size: 15px;
    letter-spacing: 0.11em;
    opacity: 0.5;
  }

  .dg-id {
    font-size: 34px;
    letter-spacing: -0.01em;
    opacity: 0.45;
  }

  .dg-val {
    font-size: 18px;
    opacity: 0.5;
  }

  .dg-end {
    text-anchor: end;
  }

  /* the boundary the pattern drew. hairline for what it caught, full weight
     for the row it did not */
  .dg-brace {
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.3;
  }

  .dg-brace-on {
    stroke: currentColor;
    stroke-width: 2;
    opacity: 1;
  }

  /* thumb only: the id, redacted to its shape */
  .dg-body {
    fill: currentColor;
    opacity: 0.25;
  }

  .dg-tail {
    fill: currentColor;
    opacity: 0.55;
  }

  .dg-open {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    opacity: 1;
  }

  .dg-rule {
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.18;
  }

  /*
   * The thumb viewBox is 400 units against a card about 250px wide, so a one
   * unit stroke lands under a pixel. The boundary is the entire figure at this
   * size, so it cannot be allowed to thin out.
   */
  .dg-t .dg-brace {
    stroke-width: 3;
  }

  .dg-t .dg-brace-on {
    stroke-width: 5;
  }

  /* Last, deliberately. It is combined with .dg-body, which sets an opacity of
     its own, and equal specificity is settled by order. */
  .dg-on {
    opacity: 1;
  }
</style>
