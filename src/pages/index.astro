---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getDiagram } from "../components/diagrams";
import { SITE_STATEMENT, SITE_BLURB } from "../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/*
 * A front page rather than a list: the newest piece runs large, the next two
 * stack in a rail beside it, and everything after that falls into the row
 * underneath. Slicing rather than indexing so the page composes at any count.
 */
const [lead, ...rest] = posts;
const rail = rest.slice(0, 2);
const row = rest.slice(2);

/*
 * Every preview here is the STRIPPED variant, never the labelled one. The lead
 * figure lands around 700px wide, where the labelled version's 15px captions
 * would render near 9px. The labelled figure is what you get for opening the
 * piece, and the front page shows the shape of the idea instead.
 */
const LeadArt = (lead ? getDiagram(lead.data.diagram) : null) as any;
---

<Base>
  <section class="statement">
    <div class="shell">
      <span class="kicker">Teximos</span>
      <p>{SITE_STATEMENT}</p>
      <p class="sub">{SITE_BLURB}</p>
    </div>
  </section>

  {
    lead && (
      <section class="front">
        <div class="shell">
          <div class:list={["front-grid", rail.length === 0 && "front-solo"]}>
            <article class="lead">
              <a class="lead-link" href={`/blog/${lead.id}/`}>
                {LeadArt && (
                  <span class="plate">
                    <LeadArt variant="thumb" />
                  </span>
                )}
                <span class="kicker">{lead.data.topic}</span>
                <h2>{lead.data.title}</h2>
              </a>
              <p class="deck">{lead.data.description}</p>
              <span class="meta">
                <FormattedDate date={lead.data.date} />
              </span>
            </article>

            {rail.length > 0 && (
              <div class="rail">
                {rail.map((post) => {
                  const Art = getDiagram(post.data.diagram) as any;
                  return (
                    <article class="rail-item">
                      <a href={`/blog/${post.id}/`}>
                        {Art && (
                          <span class="card-art">
                            <Art variant="thumb" />
                          </span>
                        )}
                        <span class="kicker">{post.data.topic}</span>
                        <h3>{post.data.title}</h3>
                        <p>{post.data.description}</p>
                        <span class="meta">
                          <FormattedDate date={post.data.date} style="short" />
                        </span>
                      </a>
                    </article>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    posts.length === 0 && (
      <div class="shell">
        <p class="empty">Nothing published yet.</p>
      </div>
    )
  }

  {
    row.length > 0 && (
      <section class="more">
        <div class="shell">
          <ul class="grid">
            {row.map((post) => {
              const Art = getDiagram(post.data.diagram) as any;
              return (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    {Art && (
                      <span class="card-art">
                        <Art variant="thumb" />
                      </span>
                    )}
                    <span class="kicker">{post.data.topic}</span>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <span class="meta">
                      <FormattedDate date={post.data.date} style="short" />
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <section class="colophon">
    <div class="shell">
      <div class="inner">
        <div>
          <span class="kicker">Colophon</span>
          <p>
            Published irregularly, when something breaks in a way worth
            writing down. Set in Newsreader and JetBrains Mono. Built with
            Astro and served from Cloudflare. It ships no JavaScript beyond
            the theme switch.
          </p>
        </div>
        <div class="feed">
          <span class="kicker">Subscribe</span>
          <a href="/rss.xml">teximos.com/rss.xml</a>
        </div>
      </div>
    </div>
  </section>
</Base>
