---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Preview from "../components/Preview.astro";
import { SITE_STATEMENT, SITE_BLURB, NEWSLETTER } from "../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/*
 * A front page rather than a list: the newest piece runs large, the next two
 * stack in a rail beside it, and everything after that falls into the row
 * underneath. Slicing rather than indexing so the page composes at any count.
 */
const [lead, ...rest] = posts;
const rail = rest.slice(0, 3);
const row = rest.slice(3);

// Preview.astro picks between a real cover image and the stripped figure. The
// reasoning for that choice lives there.
---

<Base>
  <section class="statement">
    <div class="shell">
      <span class="kicker">Teximos</span>
      <p>{SITE_STATEMENT}</p>
      <p class="sub">{SITE_BLURB}</p>
    </div>
  </section>

  {
    lead && (
      <section class="front">
        <div class="shell">
          <div class:list={["front-grid", rail.length === 0 && "front-solo"]}>
            <article class="lead">
              <a class="lead-link" href={`/blog/${lead.id}/`}>
                <Preview post={lead} size="lead" />
                <span class="kicker">{lead.data.topic}</span>
                <h2>{lead.data.title}</h2>
              </a>
              <p class="deck">{lead.data.description}</p>
              <span class="meta">
                <FormattedDate date={lead.data.date} />
              </span>
            </article>

            {rail.length > 0 && (
              <div class:list={["rail", rail.length === 3 && "rail-3"]}>
                {rail.map((post) => {
                  return (
                    <article class="rail-item">
                      <a href={`/blog/${post.id}/`}>
                        <Preview post={post} size="card" />
                        <span class="kicker">{post.data.topic}</span>
                        <h3>{post.data.title}</h3>
                        <p>{post.data.description}</p>
                        <span class="meta">
                          <FormattedDate date={post.data.date} style="short" />
                        </span>
                      </a>
                    </article>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    posts.length === 0 && (
      <div class="shell">
        <p class="empty">Nothing published yet.</p>
      </div>
    )
  }

  {
    row.length > 0 && (
      <section class="more">
        <div class="shell">
          <ul
            class:list={[
              "grid",
              row.length === 1 && "grid-1",
              row.length === 2 && "grid-2",
            ]}
          >
            {row.map((post) => {
              return (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    <Preview post={post} size="card" />
                    <span class="kicker">{post.data.topic}</span>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <span class="meta">
                      <FormattedDate date={post.data.date} style="short" />
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <section class="colophon">
    <div class="shell">
      <div class="inner">
        <div>
          <span class="kicker">Colophon</span>
          <p>
            Published when something in technology is worth explaining
            properly. Set in Newsreader and JetBrains Mono. Built with Astro
            and served from Cloudflare. It ships no JavaScript beyond the
            theme switch. Search runs only on the archive page.
          </p>
        </div>
        <div class="feed">
          <span class="kicker">Subscribe</span>
          <p class="feed-note">
            Each new piece by email. Nothing else, and one link unsubscribes.
          </p>
          <form
            class="subscribe-form"
            action={NEWSLETTER.action}
            method="post"
            target="_blank"
          >
            <input type="hidden" name="embed" value="1" />
            <input
              type="email"
              name="email"
              inputmode="email"
              autocomplete="email"
              placeholder="you@example.com"
              aria-label="Email address"
              required
            />
            <button type="submit">Subscribe</button>
          </form>
          <a class="feed-rss" href="/rss.xml">Or follow the RSS feed</a>
        </div>
      </div>
    </div>
  </section>
</Base>
