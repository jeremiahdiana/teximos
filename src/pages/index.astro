---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getDiagram } from "../components/diagrams";
import { SITE_STATEMENT, SITE_BLURB } from "../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const [lead, ...rest] = posts;
const LeadArt = (lead ? getDiagram(lead.data.diagram) : null) as any;
---

<Base>
  <section class="statement">
    <div class="shell">
      <span class="kicker">Teximos</span>
      <p>{SITE_STATEMENT}</p>
      <p class="sub">{SITE_BLURB}</p>
    </div>
  </section>

  {
    lead && (
      <section class="lead-section">
        <div class="shell">
          {LeadArt && (
            <a class="lead-art" href={`/blog/${lead.id}/`} tabindex="-1" aria-hidden="true">
              <span class="art-wide">
                <LeadArt variant="hero" />
              </span>
              <span class="art-narrow">
                <LeadArt variant="thumb" />
              </span>
            </a>
          )}
          <div class="lead">
            <div>
              <span class="kicker">{lead.data.topic}</span>
              <a class="title" href={`/blog/${lead.id}/`}>
                <h2>{lead.data.title}</h2>
              </a>
            </div>
            <div class="aside">
              <p>{lead.data.description}</p>
              <span class="meta">
                <FormattedDate date={lead.data.date} />
              </span>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    posts.length === 0 && (
      <div class="shell">
        <p class="empty">Nothing published yet.</p>
      </div>
    )
  }

  {
    rest.length > 0 && (
      <section class="more">
        <div class="shell">
          <span class="kicker">More</span>
          <ul class="grid">
            {rest.map((post) => {
              const Art = getDiagram(post.data.diagram) as any;
              return (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    {Art && (
                      <span class="card-art">
                        <Art variant="thumb" />
                      </span>
                    )}
                    <span class="kicker">{post.data.topic}</span>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <span class="meta">
                      <FormattedDate date={post.data.date} style="short" />
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <section class="colophon">
    <div class="shell">
      <div class="inner">
        <div>
          <span class="kicker">Colophon</span>
          <p>
            Published irregularly, when something breaks in a way worth
            writing down. Set in Newsreader and JetBrains Mono. Built with
            Astro and served from Cloudflare. It ships no JavaScript beyond
            the theme switch.
          </p>
        </div>
        <div class="feed">
          <span class="kicker">Subscribe</span>
          <a href="/rss.xml">teximos.com/rss.xml</a>
        </div>
      </div>
    </div>
  </section>
</Base>
