---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base>
  <p class="intro">
    Notes on shipping software, mostly the parts that went wrong. Written by
    Jeremiah Diana while building <a href="https://moduspilot.com">MODUS</a>.
  </p>

  {
    posts.length === 0 ? (
      <p class="intro">Nothing published yet.</p>
    ) : (
      <ul class="postlist">
        {posts.map((post) => (
          <li>
            <a class="row" href={`/blog/${post.id}/`}>
              <span class="date">
                <FormattedDate date={post.data.date} style="short" />
              </span>
              <span>
                <span class="title">{post.data.title}</span>
                <span class="desc">{post.data.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
