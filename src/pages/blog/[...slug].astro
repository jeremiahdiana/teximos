---
import { getCollection, render } from "astro:content";
import Post from "../../layouts/Post.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  // Sorted newest-first, so the previous index is the newer piece and the next
  // is the older one. Nulls at the ends drop the link on that side.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1]
        ? { slug: posts[i - 1].id, title: posts[i - 1].data.title }
        : null,
      older: posts[i + 1]
        ? { slug: posts[i + 1].id, title: posts[i + 1].data.title }
        : null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

// A rough read time from the raw body, at 200 words a minute. Import lines and
// JSX in the mdx inflate it slightly, which is close enough for a metabox note.
const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.round(words / 200));
---

<Post
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  topic={post.data.topic}
  diagram={post.data.diagram}
  cover={post.data.cover}
  coverAlt={post.data.coverAlt}
  slug={post.id}
  newer={newer}
  older={older}
  readingTime={readingTime}
>
  <Content />
</Post>
