---
import { Image } from "astro:assets";
import Base from "./Base.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getDiagram } from "../components/diagrams";
import { topicSlug } from "../lib/topics";
import { AUTHOR } from "../consts";

interface Sibling {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  topic: string;
  diagram?: string;
  /** A real image, which wins over `diagram` when both are set. */
  cover?: ImageMetadata;
  coverAlt?: string;
  /** Collection id, which is also the slug the social card is filed under. */
  slug: string;
  /** The next newer and next older pieces, for the foot navigation. */
  newer?: Sibling | null;
  older?: Sibling | null;
  /** Estimated read time in minutes, shown in the metabox. */
  readingTime?: number;
}

const {
  title,
  description,
  date,
  topic,
  diagram,
  cover,
  coverAlt,
  slug,
  newer,
  older,
  readingTime,
} = Astro.props;
const Hero = getDiagram(diagram) as any;
---

<Base
  title={title}
  description={description}
  bare
  type="article"
  image={`/og/${slug}.png`}
>
  <article data-pagefind-body>
    {
      cover ? (
        /* A photograph or a screenshot runs edge to edge. Boxing it inside the
           same padded band the drawn figures use would read as a slide. */
        <div class="hero hero-photo">
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            widths={[760, 1520, 2280]}
            sizes="100vw"
            loading="eager"
          />
        </div>
      ) : Hero ? (
        <div class="hero">
          <div class="hero-inner">
            {/*
              SVG text scales with the viewBox, so the labelled variant drops to
              about 5px of type on a phone. The stripped variant is served
              instead, where the shapes still carry the comparison.
            */}
            <div class="art-wide">
              <Hero variant="hero" />
            </div>
            <div class="art-narrow">
              <Hero variant="thumb" />
            </div>
          </div>
        </div>
      ) : null
    }

    <div class="shell shell-article">
      <div class="article-head">
        <div>
          <span class="byline">{AUTHOR.name}</span>
          <h1>{title}</h1>
          <p class="deck">{description}</p>
        </div>

        <aside class="metabox">
          <div class="row">
            <span class="k">Topic</span>
            <a class="v" href={`/topic/${topicSlug(topic)}/`}>{topic}</a>
          </div>
          <div class="row">
            <span class="k">Published</span>
            <span class="v"><FormattedDate date={date} /></span>
          </div>
          {
            readingTime && (
              <div class="row">
                <span class="k">Reading</span>
                <span class="v">{readingTime} min</span>
              </div>
            )
          }
        </aside>
      </div>

      <div class="prose article-body">
        <slot />
      </div>

      {
        (newer || older) && (
          <nav class="post-nav" aria-label="More pieces" data-pagefind-ignore>
            <div class="post-nav-cell">
              {newer && (
                <a href={`/blog/${newer.slug}/`}>
                  <span class="kicker">Newer</span>
                  <span class="post-nav-title">{newer.title}</span>
                </a>
              )}
            </div>
            <div class="post-nav-cell post-nav-older">
              {older && (
                <a href={`/blog/${older.slug}/`}>
                  <span class="kicker">Older</span>
                  <span class="post-nav-title">{older.title}</span>
                </a>
              )}
            </div>
          </nav>
        )
      }
    </div>
  </article>
</Base>
